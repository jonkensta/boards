	(text "J1 to Pi header: 1=5V (pin 2), 2=GND (pin 6), 3=LRCK (GPIO19, pin 35), 4=DIN (GPIO21, pin 40), 5=BCK (GPIO18, pin 12), 6=XSMT (any GPIO, optional)."
		(exclude_from_sim no)
		(at 73.66 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
