	(text "J1 to Pi header: 1=5V (pin 2), 2=GND (pin 6), 3=LRCK (GPIO19, pin 35), 4=DIN (GPIO21, pin 40), 5=BCK (GPIO18, pin 12), 6=XSMT (any GPIO, optional)."
		(exclude_from_sim no)
		(at 73.66 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "289eb95d-1b89-43f3-a842-e8daa4007b16")
	)
	(text "SCK grounded: the PCM5102A derives its clocks from BCK (3-wire mode). FMT low = I2S, DEMP low, FLT low = normal latency."
		(exclude_from_sim no)
		(at 73.66 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8a5e87a7-e248-4e9b-87a5-a4b2b03c3a1e")
	)
	(text "XSMT: 10k pull-up un-mutes at power-up; a GPIO can drive it for pop-free mute (edges must be < 20 ns, so no RC on this pin)."
		(exclude_from_sim no)
		(at 73.66 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a40a4bef-301f-4a95-b255-7f7276337a97")
	)
	(text "Output: 2.1 Vrms ground-centred (no coupling caps); 470 R + 2.2 nF is the TI-recommended filter. Load >= 1 kOhm."
